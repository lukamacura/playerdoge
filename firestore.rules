rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      // User can read their own doc
      allow read: if request.auth != null && request.auth.uid == uid;

      // User can create their own doc at registration
      allow create: if request.auth != null && request.auth.uid == uid;

      // User can update their own doc but cannot touch balance or referral
      // fields (those are written server-side via admin SDK, which bypasses
      // these rules — see /api/purchase and lib/creditPurchase.ts)
      allow update: if request.auth != null
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['coins', 'creatorCode', 'creatorCodeAppliedAt', 'freePackageStatus', 'firstPurchaseAt']);

      match /purchases/{purchaseId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        // Every purchase — coin top-ups and game orders alike — is written
        // server-side with the admin SDK, so clients never write here.
        allow write: if false;
      }
    }

    // Creator codes: authenticated users can read (for badge display)
    // All writes go through admin SDK (server-side)
    match /creatorCodes/{code} {
      allow read: if request.auth != null;
    }
  }
}
